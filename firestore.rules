rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Doc shape: users/{uid} → UserSettings + { pushToken, lastNotifiedKey }.
    // The lastNotifiedKey/pushToken fields are only ever written by the
    // Cloud Function (Admin SDK, which bypasses these rules entirely) or by
    // the signed-in user themself via lib/firebase.ts / lib/push.ts.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
